# Public site configuration.
#
# Every value here is read in src/config/site.ts and is safe to expose: these
# are public destinations, not secrets. Never put credentials or API keys in a
# NEXT_PUBLIC_ variable (SRS SEC-003).
#
# Channels left unset are omitted from the UI rather than rendered as dead
# links, so it is safe to ship without them.

# Canonical production origin, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://ocs-mocha.vercel.app

# Official OCS WhatsApp community invitation.
NEXT_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/KfIbhy1foiZ25RPhyGZM6o

# Official OCS LinkedIn company page.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/oman-computing-society
# Official OCS Instagram.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/omancomputingsociety
NEXT_PUBLIC_CONTACT_EMAIL=

# Postgres (local/dev secrets — copy to .env.local, never commit real values)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth. BETTER_AUTH_URL must be the exact app origin used for OAuth
# callbacks (local: http://localhost:3000, production: the live site origin).
# BETTER_AUTH_SECRET must be at least 32 characters. Never use NEXT_PUBLIC_ for
# these, and do not reuse NEON_AUTH_COOKIE_SECRET.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Self-managed OAuth apps. Callbacks:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   {BETTER_AUTH_URL}/api/auth/callback/microsoft
#   {BETTER_AUTH_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Legacy Neon Auth (kept for soak/rollback; unused by the application).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
